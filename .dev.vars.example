# Copia este archivo a .dev.vars (ignorado por git) para `npm run pages:dev`.
# Estos valores SOBRESCRIBEN [vars] de wrangler.toml solo en local.
# En producción los secretos se guardan con: wrangler pages secret put <NOMBRE>

ENVIRONMENT=development
APP_URL=http://localhost:8788
ALLOWED_ORIGINS=http://localhost:8788,http://localhost:5173

# Claves de PRUEBA oficiales de Turnstile (siempre pasan). Nunca en producción:
#   site key   1x00000000000000000000BB  (invisible, como el widget de producción)
#   site key   1x00000000000000000000AA  (visible)
#   secret key 1x0000000000000000000000000000000AA
# (2x0000000000000000000000000000000AA = secret que siempre falla, útil para probar errores)
TURNSTILE_SITE_KEY=1x00000000000000000000BB
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Secreto para firmar sesiones y magic links. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=REEMPLAZAR_con_un_valor_aleatorio_de_al_menos_32_caracteres

# Opcionales en local: sin BREVO_API_KEY el magic link se imprime en consola;
# sin GEMINI_API_KEY se salta directamente al fallback de Workers AI.
BREVO_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
