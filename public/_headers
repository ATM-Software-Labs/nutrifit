# NutriFit · cabeceras de seguridad para los ESTÁTICOS (Cloudflare Pages).
# Las respuestas de /api/* (Functions) reciben sus cabeceras en functions/_middleware.ts.
# Turnstile: https://developers.cloudflare.com/turnstile/reference/content-security-policy/
# worker-src blob: → canvas-confetti dibuja en un Web Worker creado desde un Blob.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com; img-src 'self' data: blob:; style-src 'self'; font-src 'self'; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

# Recursos con hash de Vite: caché de 1 año inmutable.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Iconos y logos (sin hash en el nombre): 30 días + revalidación en segundo plano.
/icons/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/favicon.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/favicon.ico
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/logo*.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# El HTML y el manifest siempre frescos (para que los despliegues se vean al momento).
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/boot.js
  Cache-Control: no-cache

# Fuente autoalojada (nombre estable; cambia rara vez).
/fonts/*
  Cache-Control: public, max-age=31536000, stale-while-revalidate=86400

# Aterrizaje del magic link de la app: el token viaja en la URL → nunca en caché
# ni en el Referer.
/app-login
  Cache-Control: no-store
  Referrer-Policy: no-referrer
/app-login.html
  Cache-Control: no-store
  Referrer-Policy: no-referrer

# Digital Asset Links (verificación de App Links de Android).
/.well-known/assetlinks.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
