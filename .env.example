# Variables PÚBLICAS de compilación del frontend (Vite). Copia a .env.local si
# necesitas cambiarlas; en CI las define .github/workflows/compilar-apk.yml.
# Repositorio de GitHub para enlaces de código y descarga del APK.
VITE_GITHUB_REPO=ATM-Software-Labs/nutrifit
# API de la web y de Android. El valor por defecto del código es el gateway.
# En local, apunta al Vite (5173) para que su proxy llegue a Pages en 8788:
# VITE_API_URL=http://localhost:5173
VITE_API_URL=https://api.trujillomingorance.com/v1
